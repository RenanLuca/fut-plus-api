meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "owner.test@peladaplus.com",
    "password": "senha123",
    "name": "Dono Teste",
    "position": "STRIKER"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve criar o usuário e retornar o accessToken", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property('accessToken');
    bru.setVar("authToken", res.getBody().accessToken);
  });
}

docs {
  Cria o usuário dono do grupo usado no resto da collection.
  
  Se rodar a collection mais de uma vez, esse request vai falhar com 409
  (e-mail já em uso) — nesse caso, rode direto o "Signin" em vez deste,
  ou troque o e-mail aqui antes de rodar de novo.
  
  ### Resposta 201
  ```json
  {
    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
  }
  ```
}
