meta {
  name: Forgot password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nao.existe@peladaplus.com"
  }
}

tests {
  test("deve responder 200 mesmo que a conta não exista", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('message');
  });
}

docs {
  Pede o link de redefinição de senha (FRONTEND_URL/reset-password?token=...,
  válido por 1h). Sempre responde 200, exista a conta ou não.

  Aqui usa um email inexistente pra não disparar email real durante a
  collection; troque pelo email do dono pra testar o fluxo de verdade.
  Limite: 3 requests por minuto por IP.
}
