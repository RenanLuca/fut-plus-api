meta {
  name: Create payment (diarista, partida futura)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/groups/{{groupId}}/group-payments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken2}}
}

body:json {
  {
    "amount": 15,
    "matchId": "{{matchId}}"
  }
}

tests {
  test("deve recusar pagamento avulso de partida que ainda não aconteceu", function() {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  Usa o authToken2, que entrou no grupo como DAILY (pasta 4-group-members),
  então passa da regra de tipo de membro e chega na checagem da partida.

  {{matchId}} vem de "Create match" (pasta 6-group-matches), que usa
  matchDate fixo em 2027 de propósito. Como a partida ainda não
  aconteceu, checkIfUserWentToMatch nunca chega a ser satisfeito e o
  service lança BadRequestException antes disso — aqui isso é usado como
  teste negativo, não indica um bug.
}
