meta {
  name: Join group via invite
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/invites/{{inviteId}}/accept
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken2}}
}

body:json {
  {
    "type": "DAILY",
    "rank": "BRASILEIRAO"
  }
}

tests {
  test("deve conectar o usuário autenticado como membro DAILY", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().type).to.equal("DAILY");
    bru.setVar("userId2", res.getBody().userId);
  });
}

docs {
  Único jeito de entrar num grupo (o antigo POST /group-members foi
  removido). Quem entra é sempre o usuário autenticado; escolhe o tipo
  (MONTHLY ou DAILY) e o rank. Aqui entra como DAILY, para exercitar as regras de pagamento por partida. Usa o authToken2 (do "Signup 2"): não
  precisa ser dono nem membro. Se já for membro, responde 409.

  Rode depois do "Create group invite" — precisa do inviteId. Captura o
  userId2 a partir da resposta, usado depois no "Remove member".
}
