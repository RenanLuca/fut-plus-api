meta {
  name: Find all group members
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/group-members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("deve listar dono e membro secundário", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
    expect(res.getBody().length).to.be.at.least(2);
  });
}

docs {
  Lista os GroupMember do grupo (dono criado junto do grupo e membro
  secundário criado no request anterior), com os dados do usuário
  (nome, posição, foto) em `user`.
}
