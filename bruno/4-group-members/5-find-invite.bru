meta {
  name: Find group invite
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/invite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("deve devolver o convite ativo do grupo", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("inviteId"));
  });
}

docs {
  Só o dono. Responde 404 se o grupo não tem convite ativo (nunca gerou
  ou já revogou).
}
