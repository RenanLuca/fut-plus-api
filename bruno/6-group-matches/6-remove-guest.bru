meta {
  name: Remove guest from match
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/guests/{{guestUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("deve apagar o convidado, só o dono pode", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Protegido por GroupOwnerGuard. Apaga o GuestUser inteiro; a presença e o
  lugar no time (se houver) somem junto por causa do onDelete: Cascade.

  Rode depois de 7-match-presences, 8-match-teams e 9-match-team-players,
  senão o convidado deixa de existir pros requests dessas pastas.
}
